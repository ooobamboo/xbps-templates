# Template file for 'wawa-git'
pkgname=wawa-git
version=2d4debc37d4541e24223fceff1496cbd8f8f5d5d
revision=1
build_style=gnu-makefile
make_use_env=yes
# The Makefile's link rule puts $(LIBS) before the objects, so the
# -Wl,--as-needed from xbps-src's LDFLAGS drops the wayland client libs.
make_build_args="LDFLAGS+=-Wl,--no-as-needed"
hostmakedepends="pkg-config wayland-devel"
makedepends="wayland-devel wayland-protocols"
short_desc="Simple hackable Wayland wallpaper setter (git master)"
maintainer="sewn <sewn@disroot.org>"
license="MIT"
homepage="https://codeberg.org/sewn/wawa"
distfiles="${homepage}/archive/${version}.tar.gz"
wrksrc="wawa"
checksum=14bcb0a1b317dbbfd270747a0e62cdbf5f3b62e8aae565fcde73a1fb0c2e8491

post_install() {
	vlicense LICENSE
}
